# 应用配置
APP_NAME=BidFlow API
APP_ENV=development

# 数据库配置（SQLite）
DATABASE_URL=sqlite:///./data/bidflow.db

# 上传配置
MAX_UPLOAD_SIZE=52428800

# Chroma 向量库配置
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# 大模型 API 配置（可选，用于真实 LLM 调用）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus

# JWT 配置（生产环境务必修改）
JWT_SECRET_KEY=your-secret-key-change-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
